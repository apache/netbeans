<project name="ide/o.eclipse.jgit" default="build" basedir=".">
    <import file="../../nbbuild/templates/projectized.xml"/>
    <!--
        The NetBeans module org.eclipse.jgit is just a repackaging of the
        original bundle, with org.ietf.jgss added to the Import Package
        list.
    -->
    <target name="jar" depends="-define-FileCRC32Calculator">
        <property name="org.eclipse.jgit.jar" value="external/org.eclipse.jgit-7.7.1.202607240634-r.jar" />
        <delete dir="build/jar-extract" />
        <mkdir dir="build/jar-extract" />
        <unzip src="${org.eclipse.jgit.jar}" dest="build/jar-extract">
            <patternset>
                <include name="META-INF/MANIFEST.MF"/>
            </patternset>
        </unzip>
        <parsemanifest property="org.eclipse.jgit.jar.import.package" 
                       manifest="build/jar-extract/META-INF/MANIFEST.MF"
                       attribute="Import-Package"/>
        <FileCRC32Calculator file="${org.eclipse.jgit.jar}" property="org.eclipse.jgit.crc32" />
        <jar jarfile="${cluster}/${module.jar}" filesetmanifest="merge">
            <zipfileset src="${org.eclipse.jgit.jar}">
                <exclude name="META-INF/*.RSA"/>
                <exclude name="META-INF/*.SF"/>
            </zipfileset>
            <manifest>
                <attribute name="Import-Package" value="${org.eclipse.jgit.jar.import.package},org.ietf.jgss"/>
                <attribute name="NB-Original-CRC" value="${org.eclipse.jgit.crc32}"/>
            </manifest>
        </jar>
    </target>
</project>
