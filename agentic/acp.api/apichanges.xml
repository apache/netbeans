<!DOCTYPE apichanges PUBLIC "-//NetBeans//DTD API changes list 1.0//EN" "../../nbbuild/javadoctools/apichanges.dtd">
<apichanges>
  <apidefs><apidef name="acp">ACP Agent API</apidef></apidefs>
  <changes>
    <change id="initial-acp-api">
      <api name="acp"/>
      <summary>Introduce the ACP Agent API</summary>
      <version major="1" minor="0"/>
      <date day="10" month="10" year="2026"/>
      <compatibility addition="yes"/>
      <description><p>Introduce agent configuration, connection and session
        APIs and an SPI for supplying MCP servers to ACP sessions.</p></description>
      <class package="org.netbeans.modules.acp.api" name="AcpConnection"/>
      <class package="org.netbeans.modules.acp.spi" name="AcpMcpServerProvider"/>
    </change>
  </changes>
  <htmlcontents>
    <head><title>ACP Agent API Changes</title></head>
    <body>
      <p class="overviewlink"><a href="overview-summary.html">Overview</a></p>
      <h1>ACP Agent API Changes</h1>
      <standard-changelists module-code-name="$codebase"/>
      <p>@FOOTER@</p>
    </body>
  </htmlcontents>
</apichanges>
