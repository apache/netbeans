    Maven goal sequences for the payara-server-maven-plugin integration.

    Start:  mvn package fish.payara.maven.plugins:payara-server-maven-plugin:start
    Dev:    mvn package fish.payara.maven.plugins:payara-server-maven-plugin:dev
    Stop:   mvn fish.payara.maven.plugins:payara-server-maven-plugin:stop

    Debug flags: -Dpayara.debug=true -Dpayara.debug.port=${port}

-->
<actions>

    <!-- ── Standard run: dev mode (continuous redeployment) ── -->
    <action>
        <actionName>run</actionName>
        <packagings>
            <packaging>war</packaging>
        </packagings>
        <goals>
            <goal>package</goal>
            <goal>payara-server:dev</goal>
        </goals>
        <properties>
            <netbeans.deploy>false</netbeans.deploy>
        </properties>
    </action>

    <action>
        <actionName>run.single.deploy</actionName>
        <packagings>
            <packaging>war</packaging>
        </packagings>
        <goals>
            <goal>package</goal>
            <goal>payara-server:dev</goal>
        </goals>
        <properties>
            <netbeans.deploy>false</netbeans.deploy>
            <netbeans.deploy.clientUrlPart>${webpagePath}</netbeans.deploy.clientUrlPart>
        </properties>
    </action>

    <!-- ── Debug: dev mode with debug socket open ── -->
    <!-- Payara Server JVM connects TO NetBeans (server=n) via payara.javaCommandLineOptions.
         jpda.listen=true makes NetBeans listen on jpda.address for the incoming connection. -->
    <action>
        <actionName>debug</actionName>
        <packagings>
            <packaging>war</packaging>
        </packagings>
        <goals>
            <goal>package</goal>
            <goal>payara-server:dev</goal>
        </goals>
        <properties>
            <payara.debug>-agentlib:jdwp=transport=dt_socket,server=n,suspend=y,address=${jpda.address}</payara.debug>
            <jpda.listen>true</jpda.listen>
            <netbeans.deploy>false</netbeans.deploy>
        </properties>
    </action>

    <action>
        <actionName>debug.single.deploy</actionName>
        <packagings>
            <packaging>war</packaging>
        </packagings>
        <goals>
            <goal>package</goal>
            <goal>payara-server:stop</goal>
            <goal>payara-server:start</goal>
        </goals>
        <properties>
            <payara.debug>-agentlib:jdwp=transport=dt_socket,server=n,suspend=y,address=${jpda.address}</payara.debug>
            <jpda.listen>true</jpda.listen>
            <netbeans.deploy.clientUrlPart>${webpagePath}</netbeans.deploy.clientUrlPart>
            <netbeans.deploy>false</netbeans.deploy>
        </properties>
    </action>

    <!-- ── Profile ── -->
    <action>
        <actionName>profile</actionName>
        <packagings>
            <packaging>war</packaging>
        </packagings>
        <goals>
            <goal>package</goal>
            <goal>payara-server:stop</goal>
            <goal>payara-server:start</goal>
        </goals>
        <properties>
            <exec.args></exec.args>
            <exec.executable>java</exec.executable>
            <netbeans.deploy>false</netbeans.deploy>
            <netbeans.deploy.profilemode>true</netbeans.deploy.profilemode>
        </properties>
    </action>

    <action>
        <actionName>profile.single.deploy</actionName>
        <packagings>
            <packaging>war</packaging>
        </packagings>
        <goals>
            <goal>package</goal>
            <goal>payara-server:stop</goal>
            <goal>payara-server:start</goal>
        </goals>
        <properties>
            <exec.args></exec.args>
            <exec.executable>java</exec.executable>
            <netbeans.deploy>false</netbeans.deploy>
            <netbeans.deploy.profilemode>true</netbeans.deploy.profilemode>
            <netbeans.deploy.clientUrlPart>${webpagePath}</netbeans.deploy.clientUrlPart>
        </properties>
    </action>

    <!-- ── Dev mode: continuous redeployment managed by the plugin ── -->
    <action>
        <actionName>server-maven-dev</actionName>
        <packagings>
            <packaging>war</packaging>
        </packagings>
        <goals>
            <goal>package</goal>
            <goal>payara-server:dev</goal>
        </goals>
        <properties>
            <netbeans.deploy>false</netbeans.deploy>
        </properties>
    </action>

    <action>
        <actionName>server-maven-dev-debug</actionName>
        <packagings>
            <packaging>war</packaging>
        </packagings>
        <goals>
            <goal>package</goal>
            <goal>payara-server:dev</goal>
        </goals>
        <properties>
            <payara.debug>-agentlib:jdwp=transport=dt_socket,server=n,suspend=y,address=${jpda.address}</payara.debug>
            <jpda.listen>true</jpda.listen>
            <netbeans.deploy>false</netbeans.deploy>
        </properties>
    </action>

    <!-- ── Explicit stop ── -->
    <action>
        <actionName>server-maven-stop</actionName>
        <goals>
            <goal>payara-server:stop</goal>
        </goals>
    </action>

</actions>
